API_KEY=test-api-key
ADMIN_API_KEY=admin-test-api-key

# Postgres connection string, anything missing from it (e.g. the password) is taken from the PG* variables (PGPASSWORD, ...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/por_verifier

# If you change the port here you will need to change in the Dockerfile also
PORT=3000
